# Plantilla de variables de la API. Valores de ejemplo: nunca poner aquí los reales.
# Docker lee .env.docker (ver infra/docker/docker-compose.yml): copia este archivo a .env.docker
# y rellénalo. Tras cambiarlo, recrear el contenedor con "docker compose up -d api" (restart no basta).

# --- Base de datos ---
# Única variable de conexión: Prisma la lee en prisma/schema.prisma con env("DATABASE_URL").
# Formato: mysql://USUARIO:CONTRASEÑA@SERVIDOR:PUERTO/NOMBRE_BD
# "mysql" es el nombre del servicio en docker-compose.yml y 3306 el puerto dentro de la red de Docker.
# Usuario y contraseña tienen que coincidir con MYSQL_USER y MYSQL_PASSWORD de docker-compose.yml.
# Los tests (npm test) usan esta misma URL con "_test" al final del nombre de la base (DB_NAME_test):
# esa base tiene que existir y el usuario tiene que tener permisos sobre ella.
DATABASE_URL=mysql://USER:PASSWORD@mysql:3306/DB_NAME

# --- Servidor ---
# Puerto en el que escucha la API dentro del contenedor (por defecto 3000)
PORT=3000
# Entorno. "production" en el servidor real; vacía en local.
# Con "production" la cookie del refresh token lleva Secure y el navegador solo la envía por HTTPS:
# sin HTTPS el login funciona, pero la sesión se pierde al recargar la página.
# Express y otras librerías también la leen para comportarse como en producción.
# OJO: no poner "production" en local. Con ella, un npm install o npm ci dentro del contenedor se salta
# las devDependencies (nodemon, vitest, prisma) y la API deja de arrancar en desarrollo ("npm run dev" usa nodemon).
NODE_ENV=

# --- Autenticación ---
# OBLIGATORIA. Clave para firmar los JWT, mínimo 32 caracteres: si falta o es más corta, la API no arranca.
# Se deja vacía a propósito para que nadie arranque con una clave copiada de esta plantilla.
# Generar una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Red: CORS y proxy (src/config/security.js) ---
# OPCIONAL. Orígenes del frontend que pueden llamar a la API desde otro dominio, separados por comas.
# Formato protocolo://dominio[:puerto], sin "/" al final: https://tienda.com,https://www.tienda.com
# Si uno está mal escrito, la API no arranca y dice cuál.
# Vacía = sin CORS (lo normal): frontend y API van en el mismo dominio.
# Rellenar solo si el frontend está en otro origen. Con orígenes, esas webs también pueden cargar las imágenes de /uploads.
# OJO: la cookie de sesión es SameSite=Strict, así que el frontend y la API tienen que compartir
# dominio principal (tienda.com y api.tienda.com sí; tienda.com y otra-api.com no).
CORS_ORIGINS=

# Número de proxies (Nginx, Caddy...) delante de la API. Vacía = ninguno (local, o API expuesta directamente).
# Con él Express saca la IP real del cliente de X-Forwarded-For; la usa el límite de intentos de login, registro y contacto.
# IMPORTANTE: detrás de Nginx/Caddy sin TRUST_PROXY=1, todos los clientes comparten la IP del proxy
# y el mismo contador, y un atacante bloquearía el login de todos con unos pocos fallos.
# Y al revés: sin proxy, dejarla vacía, o cualquiera podría inventarse la IP en X-Forwarded-For y saltarse el límite.
TRUST_PROXY=

# --- Marca de la tienda (src/config/brand.js) ---
# Nombre de la tienda; aparece en el remitente de los correos ("<STORE_NAME> Web"). Por defecto "Mi Tienda"
STORE_NAME=Mi Tienda
# Prefijo del número de pedido, SIN guion (el código lo añade: ORD-20261014-A3F09C).
# Máximo 10 caracteres: la columna order_number es VARCHAR(40). Por defecto "ORD".
# Cambiarlo solo afecta a los pedidos nuevos; los antiguos conservan su número.
ORDER_PREFIX=ORD

# --- Correo (formulario de contacto) ---
# Servidor SMTP con el que se envían los correos
SMTP_HOST=smtp.example.com
# Puerto SMTP. El código usa secure: false, así que lo normal es 587 (STARTTLS)
SMTP_PORT=587
# Usuario SMTP; también es la dirección del remitente
SMTP_USER=no-reply@example.com
# Contraseña del usuario SMTP
SMTP_PASS=contraseña_smtp
# Dirección a la que llegan los mensajes del formulario de contacto (no se enseña al cliente)
CONTACT_EMAIL=contacto@example.com

# --- Pagos (Stripe) ---
# Clave secreta de Stripe (sk_test_... en pruebas, sk_live_... en producción)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# Secreto para verificar la firma del webhook de Stripe (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# --- Envíos ---
# Pedido mínimo para envío gratis, en EUROS (por defecto 50)
SHIPPING_FREE_FROM=50
# Precio del envío, en CÉNTIMOS (por defecto 499 = 4,99 €)
SHIPPING_PRICE=499