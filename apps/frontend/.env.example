# Plantilla de variables del frontend. Copia este archivo a .env (desarrollo)
# o .env.production (compilación) y rellénalo.
# OJO: todo lo que empieza por VITE_ se copia dentro del JavaScript que descarga
# el navegador, así que es PÚBLICO. Nunca poner aquí claves ni contraseñas.
# Los valores se fijan al compilar: tras cambiarlos, reiniciar "npm run dev" o volver a hacer "npm run build".

# --- API ---
# URL base de la API (por defecto http://localhost:3000)
VITE_API_URL=http://localhost:3000
# URL base de las imágenes subidas, /uploads/... (por defecto http://localhost:3000)
VITE_ASSET_URL=http://localhost:3000

# --- Marca de la tienda (src/config.js) ---
# OBLIGATORIA. Nombre de la tienda: navbar, footer, textos alt y <title> de index.html.
# Si falta, la tienda usa "Mi Tienda", pero la pestaña del navegador muestra "%VITE_STORE_NAME%".
VITE_STORE_NAME=Mi Tienda
# Correo de contacto que se enseña al cliente en la ficha de producto (por defecto info@mitienda.com).
# No es CONTACT_EMAIL de la API, que es donde llegan los mensajes del formulario.
VITE_STORE_EMAIL=info@mitienda.com
