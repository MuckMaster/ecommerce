# Plantilla de variables del frontend. Copia este archivo a .env y rellénalo.
# Vite lee .env tanto en desarrollo (npm run dev) como al compilar (npm run build). Si además existe
# .env.production, solo se lee al compilar y sus valores pisan los de .env.
# OJO: todas las variables VITE_ son PÚBLICAS. Vite las copia dentro del JavaScript (y del index.html)
# que descarga el navegador, y cualquiera puede leerlas. Nunca poner en ellas claves, contraseñas ni
# ningún secreto: esos van en el .env de la API.
# Los valores se fijan al compilar: tras cambiarlos, reiniciar "npm run dev" o volver a hacer "npm run build".

# --- API ---
# OPCIONAL. URL base de la API, que sirve /api y también las imágenes de /uploads.
# Vacía = mismo dominio (lo normal): el frontend pide rutas relativas y las reenvía
# el proxy de Vite en local y el servidor web (Nginx/Caddy) en producción.
# Rellenar solo si la API está en otro dominio, p. ej. https://api.mitienda.com (necesitará CORS).
VITE_API_URL=

# --- Marca de la tienda (src/config.js) ---
# OBLIGATORIA. Nombre de la tienda: navbar, footer, textos alt y <title> de index.html.
# Si falta, la tienda usa "Mi Tienda", pero la pestaña del navegador muestra "%VITE_STORE_NAME%".
# Hace falta también al compilar: es la que usa index.html, y si npm run build no la encuentra
# avisa con "%VITE_STORE_NAME% is not defined" y el <title> sale tal cual.
VITE_STORE_NAME=Mi Tienda
# Correo de contacto que se enseña al cliente en la ficha de producto (por defecto info@mitienda.com).
# No es CONTACT_EMAIL de la API, que es donde llegan los mensajes del formulario.
VITE_STORE_EMAIL=info@mitienda.com
