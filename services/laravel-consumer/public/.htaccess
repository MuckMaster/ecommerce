<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
    RewriteBase /api/

    # Manejar cabeceras de autorización — necesario para que los JWT lleguen intactos
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Si ya viene con api/ delante, no lo tocamos (evita duplicar)
    RewriteCond %{REQUEST_URI} !^/api/api/
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    # Reinyecta el prefijo api/ y deja que Laravel enrute normalmente
    RewriteRule ^(.*)$ index.php [L,QSA,E=PATH_INFO:/api/$1]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>