APP_NAME="Laravel Consumer"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# Base de datos MySQL — mismas credenciales que usa el servicio Node.js
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ecommerce_bolsos
DB_USERNAME=1234
DB_PASSWORD=1234

# Cache y sesiones usando la base de datos (simplifica el setup)
CACHE_STORE=database
SESSION_DRIVER=database

# JWT — debe ser el MISMO secreto que JWT_SECRET en Node.js para que los
# tokens sean compatibles durante el período de migración
JWT_SECRET=dev_secret_change_in_prod

# SMTP Gmail con contraseña de aplicación (no la contraseña real de la cuenta)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Email donde se reciben los mensajes de contacto
CONTACT_EMAIL=tucuenta@gmail.com

# Stripe — usar claves de test durante desarrollo
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Envío gratuito a partir de este importe en euros
SHIPPING_FREE_FROM=50
# Precio de envío en céntimos (499 = 4.99€)
SHIPPING_PRICE=499

# Cola de trabajos (database driver para simplificar, no necesita Redis)
QUEUE_CONNECTION=database

# Logs a fichero local
LOG_CHANNEL=stack
LOG_LEVEL=debug
